@model IEnumerable<ProjetDeSession_2290726.Models.VwNbCapsulesDuBresilParCollection>

@{
    ViewData["Title"] = "IndexVue";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Nombre de Capsules du Brésil par Collection</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CollectionId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreDeCapsulesDuBrésil)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NombreDeCapsulesDuBrésil)
            </td>
        </tr>
}
    </tbody>
</table>
