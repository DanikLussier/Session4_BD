@model ViewModels.FiltreCapsuleViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Bonjour @ViewData["utilisateur"]!</h1>

<a asp-action="Connexion" asp-controller="Utilisateurs">Connexion</a>
<a asp-action="Inscription" asp-controller="Utilisateurs">Inscription</a>
<a asp-action="Deconnexion" asp-controller="Utilisateurs">Deconnexion</a>

<p>
    <a asp-action="IndexImages">Images</a>
</p>

<p>
    <a asp-action="IndexVue">Index de la vue</a>
</p>
<p>
    <a asp-action="Create">Create New</a>
</p>

@if (ViewData["utilisateur"]!.ToString() != "Visiteur")
{
    <form asp-action="IndexFiltre">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="form-group col-6">
                <label asp-for="Name" class="control-label"></label>
                <div>
                    <input asp-for="Name" class="form-control" />
                </div>
            </div>
            <div class="form-group col-3">
                <label asp-for="AmertumeMin" class="control-label"></label>
                <div>
                    <input asp-for="AmertumeMin" class="form-control" />
                </div>
            </div>
            <div class="form-group col-3">
                <label asp-for="AmertumeMax" class="control-label"></label>
                <div>
                    <input asp-for="AmertumeMax" class="form-control" />
                </div>
            </div>
            <div class="form-group col-3">
                <label asp-for="PrixUniteMax" class="control-label"></label>
                <div>
                    <input asp-for="PrixUniteMax" class="form-control" />
                </div>
            </div>
            <div class="form-group col-auto">
                <div class="col-md-offset-2">
                    <button type="submit" class="btn btn-light">Filtrer</button>
                </div>
            </div>
        </div>
    </form>
}


<table class="table">
    <thead>
        <tr>
            <th>
                Nom
            </th>
            <th>
                Description Courte
            </th>
            <th>
                Description Longue
            </th>
            <th>
                Description du goût
            </th>
            <th>
                Description de la torréfaction
            </th>
            <th>
                Amertume
            </th>
            <th>
                Prix par unité
            </th>
            <th>
                Collection
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Capsules) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriptionCourte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriptionLongue)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriptionGout)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriptionTorrefaction)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amertume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrixUnite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Collection.CollectionId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CapsuleId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CapsuleId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CapsuleId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
