@model IEnumerable<WrapUpBilleterie.Models.VwSpectaclesRepresentationSpectateur>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p>
    <a asp-action="Inscription" asp-controller="Clients">Inscription</a> |
    <a asp-action="Connexion" asp-controller="Clients">Connexion</a> |
    <a asp-action="Deconnexion" asp-controller="Clients">Deconnexion</a>
    @if (ViewData["PrenomNom"] != null && ViewData["PrenomNom"] != "visiteur")
    {

        @("| ")
        <a asp-action="Profil" asp-controller="Clients"> Profil </a>
    }
</p>

<h1>Index</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Debut)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbRepresentations)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbBilletsVendus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Prix)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Debut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Fin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbRepresentations)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbBilletsVendus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Prix)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.SpectacleId">Details</a> |
            </td>
        </tr>
}
    </tbody>
</table>
