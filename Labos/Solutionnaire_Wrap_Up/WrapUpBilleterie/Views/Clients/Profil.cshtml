@model WrapUpBilleterie.ViewModels.ProfilClientViewModel

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Profil</h1>

<div>
    <h4>Client</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Client.Nom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Client.Nom)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Client.Prenom)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Client.Prenom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Client.Courriel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Client.Courriel)
        </dd>
    </dl>
</div>
<table class="table">
    <h4>Moyens de paiement</h4>
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cartes.FirstOrDefault().Numero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cartes.FirstOrDefault().Echeance)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Cartes)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Numero)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Echeance)
                </td>
                <td></td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="Index" asp-controller="Spectacles">Back to List</a>
</div>
